#!/bin/bash
set -euo pipefail
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
cd /opt/personal-panel
if [[ $# == 0 ]]; then
  printf '%s\n' '用法：panelctl admin | status | access public/private/show [--port PORT] | cert DOMAIN [--panel-https] | site DOMAIN [--panel-https] | core update | core rollback'
  exit 0
fi
exec /opt/personal-panel/venv/bin/python /opt/personal-panel/manage.py "$@"
